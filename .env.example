# Bu dosyayı ".env" adıyla kopyalayın ve değerleri değiştirin:
#   Windows (PowerShell):  Copy-Item .env.example .env
# .env dosyasını ASLA paylaşmayın / git'e eklemeyin.
# Parolalarda sadece harf ve rakam kullanmanız önerilir.

# MongoDB yönetici kullanıcısı (ilk açılışta oluşturulur)
MONGO_USER=asistan
MONGO_PASSWORD=degistir_beni_guclu_bir_parola

# n8n'in kayıtlı kimlik bilgilerini şifrelemek için uzun, rastgele bir metin.
# Bir kez belirleyin, sonradan değiştirmeyin (kayıtlı credential'lar çözülemez olur).
N8N_ENCRYPTION_KEY=degistir_beni_en_az_32_karakterlik_rastgele_metin

# Varsayılan model (8 GB VRAM için önerilen: qwen2.5:7b)
LLM_MODEL=qwen2.5:7b
# İkinci model (model seçimi bonusu için; Türkçede güçlü ve hızlı)
LLM_MODEL_2=gemma3:4b

# RAG bonus özelliği için embedding modeli (şimdilik boş bırakabilirsiniz).
EMBED_MODEL=
