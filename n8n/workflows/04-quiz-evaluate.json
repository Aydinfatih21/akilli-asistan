      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "{\"ok\": false, \"error\": {\"code\": \"ALREADY_SUBMITTED\", \"message\": \"Bu test daha önce teslim edildi. Yeni bir test oluşturabilirsiniz.\"}}",
        "options": {
          "responseCode": 409,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "application/json; charset=utf-8"
