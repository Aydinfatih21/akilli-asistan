    {
      "name": "Teslim: puanla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        -300
      ],
      "parameters": {
        "jsCode": "// Puanlama KODLA yapılır (model değil). Sonra öneri için Ollama isteği hazırlanır.\nconst crypto = require('crypto');\nconst quiz = $('Teslim: test').first().json;\nconst req = $('Teslim: istek').first().json;\n\nconst given = new Map();\nfor (const a of req.answers) {\n  if (a && a.question_id !== null && a.question_id !== undefined) given.set(String(a.question_id), a.selected_index);\n}\nconst questions = [...quiz.questions].sort((a, b) => (a.position || 0) - (b.position || 0));\nconst graded = questions.map((q) => {\n  let sel = given.get(q.id);\n  sel = sel === null || sel === undefined || sel === '' ? null : Number(sel);\n  if (!(Number.isInteger(sel) && sel >= 0 && sel <= 3)) sel = null; // boş / geçersiz → yanlış\n  return { q, sel, ok: sel === q.correct_index };\n});\nconst score = graded.filter((g) => g.ok).length;\nconst total = graded.length;\nconst percent = Math.round((100 * score) / total);\n\n// Zayıf konular: yanlış sayısına göre sıralı\nconst counts = {};\nfor (const g of graded) if (!g.ok) counts[g.q.topic] = (counts[g.q.topic] || 0) + 1;\nconst weak_topics = Object.entries(counts).sort((a, b) => b[1] - a[1]).map(([t]) => t);\n\nconst wrong = graded.filter((g) => !g.ok);\nconst detail = wrong.length\n  ? wrong.map((g, i) => [\n      `${i + 1}. [${g.q.topic}] ${g.q.question}`,\n      `   Öğrencinin cevabı: ${g.sel === null ? '(boş bırakıldı)' : g.q.options[g.sel]}`,\n      `   Doğru cevap: ${g.q.options[g.q.correct_index]}`,\n      `   Açıklama: ${g.q.explanation}`,\n    ].join('\\n')).join('\\n')\n  : 'Öğrenci tüm soruları doğru yanıtladı.';\n\nconst system = [\n  'Sen öğrencilere test sonuçlarına göre kişisel çalışma önerisi veren bir öğretim asistanısın.',\n  'KURALLAR:',\n  '1. YALNIZCA Türkçe yaz. Çince, Japonca, Korece veya Kiril alfabesinden tek bir karakter bile kullanma.',\n  '2. Öğrenciye doğrudan \"sen\" diye hitap et; destekleyici ama net ol.',\n  '3. Yanlış yapılan konuları adıyla an ve her biri için somut bir çalışma adımı öner.',\n  '4. 3-5 cümle yaz; başlık veya madde işareti kullanma.',\n  '5. Tüm sorular doğruysa tebrik et ve bir sonraki adım için kısa bir öneri ver.',\n].join('\\n');\n\nreturn [{\n  json: {\n    attempt: {\n      id: crypto.randomUUID(), quiz_id: quiz.id, user_id: req.user_id, course_id: quiz.course_id,\n      score, total, percent,\n      answers: graded.map((g) => ({ question_id: g.q.id, selected_index: g.sel, is_correct: g.ok })),\n      created_at: new Date().toISOString(),\n    },\n    results: graded.map((g) => ({\n      question_id: g.q.id, selected_index: g.sel, correct_index: g.q.correct_index,\n      is_correct: g.ok, explanation: g.q.explanation,\n    })),\n    weak_topics,\n    body: {\n      model: req.model,\n      stream: false,\n      options: { temperature: 0.4, num_ctx: 4096 },\n      messages: [\n        { role: 'system', content: system },\n        { role: 'user', content: `Test: ${quiz.title}\\nPuan: ${score}/${total} (%${percent})\\n\\nYanlış yanıtlanan sorular:\\n${detail}` },\n      ],\n    },\n  },\n}];\n"
      },
      "onError": "continueErrorOutput",
      "id": "1137e77f-2f79-4ac0-8c3d-494ebf4b5c88"
    },
    {
      "name": "Teslim: sonuç",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3320,
        -380
      ],
      "parameters": {
        "jsCode": "// Sonucu birleştirir. Model geçerli öneri üretemediyse (ya da Ollama kapalıysa)\n// yanlış konulardan kural tabanlı yedek öneri yazılır; puan her durumda döner.\nconst s = $('Teslim: puanla').first().json;\nconst r = $input.first().json || {};\nconst useAi = r.valid === true && !!r.content;\n\nlet text;\nif (useAi) {\n  text = r.content;\n} else if (s.weak_topics.length) {\n  text = `Şu konularda eksiğin görünüyor: ${s.weak_topics.join(', ')}. ` +\n    'Bu konulara ait ders notlarını yeniden oku ve yanlış yaptığın soruların açıklamalarını dikkatle incele. ' +\n    'Ardından aynı nottan yeni bir test oluşturarak kendini tekrar dene.';\n} else {\n  text = 'Tebrikler, tüm soruları doğru yanıtladın! Bilgini pekiştirmek için daha zor seviyede yeni bir test ' +\n    'oluşturabilir ya da bir sonraki konuya geçebilirsin.';\n}\nconst attempt = { ...s.attempt, recommendation: text, recommendation_source: useAi ? 'ai' : 'fallback' };\nreturn [{\n  json: {\n    ...attempt,\n    response: {\n      ok: true,\n      data: {\n        attempt_id: attempt.id, score: attempt.score, total: attempt.total, percent: attempt.percent,\n        results: s.results, weak_topics: s.weak_topics,\n        recommendation: text, recommendation_source: attempt.recommendation_source,\n      },\n    },\n  },\n}];\n"
      },
      "onError": "continueErrorOutput",
      "id": "fee24377-2fea-4607-8f16-6e1af329b1e8"
    },
    {
      "name": "Öneri: Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2420,
        -300
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OLLAMA_URL }}/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({}, $('Teslim: puanla').first().json.body, { model: $('Teslim: puanla').first().json.body.model || $env.LLM_MODEL })) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "26422c61-3d85-496e-94fc-8216cba301fd"
    },
    {
      "name": "Öneri: yanıtı doğrula",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2640,
        -300
      ],
      "parameters": {
        "jsCode": "// Öneri metnini doğrular ($runIndex: deneme sırası).\nconst r = $input.first().json;\nconst content = (r.message && typeof r.message.content === 'string') ? r.message.content.trim() : '';\nconst FOREIGN = /[぀-ヿ㐀-䶿一-鿿豈-﫿가-힯Ѐ-ӿ]/;\nlet problem = null;\nif (content.length < 40) problem = 'öneri çok kısa';\nelse if (FOREIGN.test(content)) problem = 'Türkçe dışı karakter';\nreturn [{ json: { valid: problem === null, problem, attempt: $runIndex + 1, content, model: r.model || null } }];\n"
      },
      "onError": "continueErrorOutput",
      "id": "5e989368-fbc7-4207-bb00-f46808a9a9b4"
    },
