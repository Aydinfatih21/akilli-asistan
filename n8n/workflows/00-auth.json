    {
      "name": "Kayıt: oturum",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        -120
      ],
      "parameters": {
        "jsCode": "// Yeni kullanıcı için oturum anahtarı üretir. Veritabanına yalnızca SHA-256 özeti yazılır.\nconst crypto = require('crypto');\nconst u = $('Kayıt: doğrula').first().json.user;\nconst token = crypto.randomBytes(32).toString('hex');\nconst now = Date.now();\nconst expires = now + 30 * 24 * 3600 * 1000; // 30 gün\nreturn [{\n  json: {\n    token_hash: crypto.createHash('sha256').update(token).digest('hex'),\n    user_id: u.id,\n    created_at: new Date(now).toISOString(),\n    expires_at: new Date(expires).toISOString(),\n    expires_ms: expires,\n    response: { ok: true, data: { token, user: { id: u.id, name: u.name, email: u.email } } },\n  },\n}];\n"
      },
      "onError": "continueErrorOutput",
      "id": "4406e1ae-70df-471d-8311-7df69674ad49"
    },
