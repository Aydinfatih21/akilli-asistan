    {
      "name": "Çıkış: token özeti",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        840
      ],
      "parameters": {
        "jsCode": "// Authorization: Bearer <token> başlığındaki anahtarın SHA-256 özetini çıkarır.\n// Veritabanında yalnızca özet saklanır; ham anahtar sadece istemcide bulunur.\nconst crypto = require('crypto');\nconst headers = $('POST /auth/logout').first().json.headers || {};\nconst raw = String(headers.authorization || '').replace(/^Bearer\\s+/i, '').trim();\nreturn [{\n  json: {\n    token_hash: raw ? crypto.createHash('sha256').update(raw).digest('hex') : '-',\n    now_ms: Date.now(),\n  },\n}];\n"
      },
      "onError": "continueErrorOutput",
      "id": "257c76ec-8cb2-4653-90bc-81fc0f8ead41"
    },
