    {
      "name": "Notlar: birleştir",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        360
      ],
      "parameters": {
        "jsCode": "// Dersin notlarını önizleme ve özet durumu ile döndürür (en yeni önce).\nconst iso = (v) => (v ? new Date(v).toISOString() : null);\nconst notes = $input.all().map((i) => i.json).filter((d) => d && d.id)\n  .map((n) => ({\n    id: n.id,\n    title: n.title,\n    preview: String(n.content || '').replace(/\\s+/g, ' ').slice(0, 160),\n    has_summary: !!(n.summary && n.summary.short),\n    source: n.source || 'text',\n    created_at: iso(n.created_at),\n  }))\n  .sort((a, b) => String(b.created_at).localeCompare(String(a.created_at)));\nreturn [{ json: { response: { ok: true, data: { notes } } } }];\n"
      },
      "onError": "continueErrorOutput",
      "id": "5bb9e1eb-2be5-4ed8-945e-1e2e8e83cdd3"
    },
