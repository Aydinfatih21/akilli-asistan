    {
      "name": "Özet: prompt hazırla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        940
      ],
      "parameters": {
        "jsCode": "// Özet için Ollama isteğini hazırlar. \"format\" ile JSON şeması zorlanır.\nconst n = $('Özet: not').first().json;\nconst r = $('Özet: istek').first().json;\nconst schema = {\n  type: 'object',\n  properties: {\n    short: { type: 'string' },\n    key_points: { type: 'array', items: { type: 'string' }, minItems: 3, maxItems: 7 },\n    keywords: { type: 'array', items: { type: 'string' }, minItems: 3, maxItems: 8 },\n  },\n  required: ['short', 'key_points', 'keywords'],\n};\nconst system = [\n  'Sen üniversite öğrencileri için ders notlarını özetleyen bir asistansın.',\n  'KURALLAR:',\n  '1. YALNIZCA Türkçe yaz. Çince, Japonca, Korece veya Kiril alfabesinden tek bir karakter bile kullanma.',\n  '2. Yalnızca nottaki bilgileri kullan; notta olmayan bilgi ekleme.',\n  '3. \"short\": notun 2-3 cümlelik özeti.',\n  '4. \"key_points\": notun en önemli 3-7 maddesi; her madde kısa tek bir cümle.',\n  '5. \"keywords\": notun 3-8 anahtar kavramı (tek kelime veya kısa ifade).',\n  '6. Yanıtın yalnızca istenen JSON nesnesi olsun.',\n].join('\\n');\nreturn [{\n  json: {\n    body: {\n      model: r.model, // null ise .env içindeki LLM_MODEL\n      stream: false,\n      format: schema,\n      options: { temperature: 0.2, num_ctx: 8192 },\n      messages: [\n        { role: 'system', content: system },\n        { role: 'user', content: `Ders notu başlığı: ${n.title}\\n\\nDers notu:\\n${n.content}` },\n      ],\n    },\n  },\n}];\n"
      },
      "id": "7e25f154-c66b-47c0-a114-9c6ed22aac9b"
    },
    {
      "name": "Özet: kayıt belgesi",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2880,
        860
      ],
      "parameters": {
        "jsCode": "// Özeti nota kaydetmek için güncelleme belgesini ve istemci yanıtını hazırlar.\nconst n = $('Özet: not').first().json;\nconst v = $input.first().json;\nconst now = new Date().toISOString();\nreturn [{\n  json: {\n    id: n.id,\n    summary: v.summary,\n    summary_model: v.model,\n    summarized_at: now,\n    response: { ok: true, data: { note_id: n.id, summary: v.summary, model: v.model, cached: false } },\n  },\n}];\n"
      },
      "id": "6ffbdd1c-2fc3-46d9-9c89-5e5deb5ac319"
    },
    {
      "name": "Özet: Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        940
      ],
      "onError": "continueErrorOutput",
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OLLAMA_URL }}/api/chat",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({}, $('Özet: prompt hazırla').first().json.body, { model: $('Özet: prompt hazırla').first().json.body.model || $env.LLM_MODEL })) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "5b34332b-3276-4200-95aa-fa07b2b1ba6f"
    },
    {
      "name": "Özet: yanıtı doğrula",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        940
      ],
      "parameters": {
        "jsCode": "// Model özetini doğrular. Kurallardan biri bozulursa yeniden denenir ($runIndex: deneme sırası).\nconst r = $input.first().json;\nconst raw = (r.message && typeof r.message.content === 'string') ? r.message.content : '';\nconst FOREIGN = /[぀-ヿ㐀-䶿一-鿿豈-﫿가-힯Ѐ-ӿ]/;\nconst clean = (v) => String(v ?? '').trim();\nconst list = (a, max) => (Array.isArray(a) ? [...new Set(a.map(clean).filter(Boolean))].slice(0, max) : []);\n\nlet problem = null;\nlet summary = null;\ntry {\n  const j = JSON.parse(raw.trim().replace(/^```(?:json)?\\s*/i, '').replace(/\\s*```$/, ''));\n  summary = { short: clean(j.short), key_points: list(j.key_points, 7), keywords: list(j.keywords, 8) };\n  if (!summary.short) problem = 'özet boş';\n  else if (summary.key_points.length < 3) problem = 'en az 3 ana madde gerekli';\n  else if (summary.keywords.length < 3) problem = 'en az 3 anahtar kavram gerekli';\n  else if (FOREIGN.test(JSON.stringify(summary))) problem = 'Türkçe dışı karakter';\n} catch (e) {\n  problem = 'geçersiz JSON';\n}\nreturn [{ json: { valid: problem === null, problem, attempt: $runIndex + 1, summary, model: r.model || null } }];\n"
      },
      "onError": "continueErrorOutput",
      "id": "7c9dab4d-79a5-47f1-9ae9-044352be58ff"
    },
